# Paste Neon pooled connection string here (SSL required). Never commit the actual .env.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLER-HOST/neondb?sslmode=require"
# Paste Neon direct / unpooled connection string here for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@DIRECT-HOST/neondb?sslmode=require"
# The URL used in canonical links and metadata (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Required for database rate-limit key hashing. Generate: openssl rand -hex 32
RATE_LIMIT_SECRET="replace-with-long-random-secret-at-least-32-chars"

# Required server-only admin JWT signing key, independent of RATE_LIMIT_SECRET.
# Generate 32 random bytes as 64 hexadecimal characters with Node's crypto.randomBytes.
# Changing this key signs every administrator out.
ADMIN_JWT_SECRET="replace-with-64-random-hex-characters"

# Optional: signed server-side image uploads from the admin car editor.
# Leave blank to use pre-hosted HTTPS image URLs instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
